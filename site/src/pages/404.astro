---
import "../styles.css";
import { umami } from "../analytics";
---

<!doctype html>
<html lang="zh-Hans">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>404 · Godwit</title>
		<link rel="icon" href="/icon.png" type="image/png" />
		<!-- Website-only analytics, as on the other pages: which links lead nowhere. -->
		<script is:inline defer src={`${umami.origin}/script.js`} data-website-id={umami.website} data-domains={umami.domain}></script>
	</head>
	<body class="grid min-h-dvh place-items-center bg-background px-6 text-center">
		<main>
			<p class="font-mono text-sm text-muted-foreground">404</p>
			<h1 class="mt-3 text-2xl font-semibold tracking-tight">这个页面不存在 · This page doesn't exist</h1>
			<p class="mt-6 flex justify-center gap-4">
				<a href="/zh-hans/" class="underline underline-offset-4">返回首页</a>
				<a href="/en/" class="underline underline-offset-4">Back home</a>
			</p>
		</main>
	</body>
</html>
