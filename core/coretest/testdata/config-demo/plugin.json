{
  "name": "config-demo",
  "version": "0.1.0",
  "main": "index.ts",
  "permissions": {},
  "config": [
    { "key": "apiKey", "type": "secret", "label": "API Key" },
    { "key": "plan", "type": "select", "label": "套餐",
      "options": [{ "value": "free", "label": "Free" }, { "value": "pro", "label": "Pro" }],
      "default": "free" },
    { "key": "endpoint", "type": "text", "label": "自定义地址",
      "when": { "key": "plan", "equals": "pro" } }
  ]
}
